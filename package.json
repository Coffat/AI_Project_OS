{
  "name": "ai-project-os",
  "version": "0.1.0",
  "description": "Project Memory + Context + Handoff + Code Intelligence OS for AI Coding Agents",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "ai-project-os": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); fs.cpSync('src/database/migrations', 'dist/src/database/migrations', {recursive: true}); if (fs.existsSync('src/database/schema.sql')) fs.copyFileSync('src/database/schema.sql', 'dist/src/database/schema.sql');\"",
    "build:ui": "vite build ui",
    "dev": "pnpm build:ui && pnpm build && node dist/src/cli.js ui",
    "start": "node dist/src/cli.js ui",
    "dev:ui": "vite ui",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc -p ui/tsconfig.json --noEmit",
    "build:tauri": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix"
  },
  "keywords": [
    "ai-agent",
    "code-intelligence",
    "local-first",
    "mcp",
    "project-memory",
    "handoff"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.21.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^8.3.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
